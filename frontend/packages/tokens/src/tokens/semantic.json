{
  "color": {
    "text": {
      "primary": { "$value": "{color.ink.base}", "$type": "color" },
      "secondary": { "$value": "{color.ink.soft}", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "{color.paper}", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{color.green.500}", "$type": "color" },
      "soft": { "$value": "{color.green.100}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.line}", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "{color.green.500}", "$type": "color" },
      "primary-hover": { "$value": "{color.green.100}", "$type": "color" }
    }
  },
  "space": {
    "component": {
      "padding-x": { "$value": "{space.4}", "$type": "dimension" },
      "padding-y": { "$value": "{space.2}", "$type": "dimension" }
    }
  },
  "font": {
    "family": {
      "base": { "$value": "{font.family.serif}", "$type": "fontFamily" }
    }
  }
}
