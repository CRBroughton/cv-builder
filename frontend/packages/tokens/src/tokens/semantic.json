{
  "color": {
    "text": {
      "primary": { "$value": "{color.ink.base}", "$type": "color" },
      "secondary": { "$value": "{color.ink.soft}", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "{color.paper}", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{color.blue.900}", "$type": "color" },
      "soft": { "$value": "{color.blue.100}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.line}", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "{color.blue.900}", "$type": "color" },
      "primary-hover": { "$value": "{color.blue.800}", "$type": "color" },
      "destructive": { "$value": "{color.red.500}", "$type": "color" },
      "destructive-soft": { "$value": "{color.red.100}", "$type": "color" }
    }
  },
  "space": {
    "component": {
      "padding-x": { "$value": "{space.4}", "$type": "dimension" },
      "padding-y": { "$value": "{space.2}", "$type": "dimension" }
    }
  },
  "font": {
    "family": {
      "base": { "$value": "{font.family.sans}", "$type": "fontFamily" }
    }
  }
}
