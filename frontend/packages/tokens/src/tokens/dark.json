{
  "color": {
    "text": {
      "primary":   { "$value": "{color.gray.50}",  "$type": "color" },
      "secondary": { "$value": "{color.gray.400}", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "{color.gray.950}", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{color.blue.200}", "$type": "color" },
      "soft":    { "$value": "#1e3a5f",           "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.gray.600}", "$type": "color" }
    },
    "action": {
      "primary":           { "$value": "{color.blue.400}", "$type": "color" },
      "primary-hover":     { "$value": "{color.blue.500}", "$type": "color" },
      "destructive":       { "$value": "{color.red.400}", "$type": "color" },
      "destructive-soft":  { "$value": "{color.red.950}", "$type": "color" }
    }
  },
  "space": {
    "component": {
      "padding-x": { "$value": "{space.4}", "$type": "dimension" },
      "padding-y": { "$value": "{space.2}", "$type": "dimension" }
    }
  },
  "font": {
    "family": {
      "base": { "$value": "{font.family.sans}", "$type": "fontFamily" }
    }
  }
}
