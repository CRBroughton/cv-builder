{
  "name": "@cv-builder/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "curl -s http://localhost:8000/openapi.json -o openapi.json && openapi-zod-client openapi.json -o src/generated.ts --export-schemas --export-types && tsx scripts/generate-urls.ts && rm openapi.json"
  },
  "dependencies": {
    "@zodios/core": "catalog:",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "openapi-zod-client": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
